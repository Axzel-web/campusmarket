rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- 0. Global Safety Net ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- 1. Global Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn();
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isDeveloper() {
      return isSignedIn() && 
             request.auth.token.email_verified == true &&
             (request.auth.token.email == 'xeliboyydagents@gmail.com' || request.auth.token.email == 'axzelbaril460@gmail.com');
    }

    // --- 2. Validation Blueprints ---

    // schema check (optional fields checked only if present)
    function isValidUserProfileSchema(data) {
      return (!('fullName' in data) || (data.fullName is string && data.fullName.size() <= 128)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 128)) &&
             (!('role' in data) || (data.role in ['buyer', 'seller', 'admin'])) &&
             (!('isVerified' in data) || (data.isVerified is bool)) &&
             (!('onboarded' in data) || (data.onboarded is bool)) &&
             (!('interests' in data) || (data.interests is list)) &&
             (!('createdAt' in data) || (data.createdAt is timestamp || data.createdAt is int)) &&
             (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 1000)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 2000)) &&
             (!('courseAndYear' in data) || (data.courseAndYear is string && data.courseAndYear.size() <= 128)) &&
             (!('verificationStatus' in data) || (data.verificationStatus is string && data.verificationStatus.size() <= 128)) &&
             (!('studentId' in data) || (data.studentId is string && data.studentId.size() <= 128)) &&
             (!('studentIdImage' in data) || (data.studentIdImage is string && data.studentIdImage.size() <= 1000)) &&
             (!('universityEmail' in data) || (data.universityEmail is string && data.universityEmail.size() <= 128)) &&
             (!('contactDetails' in data) || (data.contactDetails is string && data.contactDetails.size() <= 512));
    }

    function hasRequiredProfileFields(data) {
      return data.keys().hasAll(['fullName', 'email', 'role', 'isVerified', 'createdAt']);
    }

    function isVerifiedSeller() {
      return isSignedIn() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'buyer') == 'seller' &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isVerified', false) == true &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('verificationStatus', '') == 'approved';
    }

    function isValidListing(data) {
      // Only require all keys on creation (when resource is null)
      return (resource != null || data.keys().hasAll(['title', 'price', 'category', 'sellerId', 'status', 'condition', 'quantity', 'location', 'contactMethod', 'createdAt'])) &&
             (!('sellerId' in data) || data.sellerId == request.auth.uid) &&
             (!('status' in data) || data.status in ['active', 'sold', 'archived']) &&
             (!('createdAt' in data) || data.createdAt == (resource == null ? request.time : existing().createdAt));
    }

    function isValidChat(data) {
      return data.participants is list && 
             data.participants.size() == 2 &&
             request.auth.uid in data.participants;
    }

    function isValidMessage(data) {
      return data.senderId == request.auth.uid &&
             data.text is string && data.text.size() <= 1000 &&
             data.createdAt == request.time;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['customerId', 'customerName', 'listingId', 'sellerId', 'rating', 'status', 'createdAt']) &&
             data.customerId == request.auth.uid &&
             data.customerName is string &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.status == 'pending' &&
             data.createdAt is timestamp;
    }

    function isValidSellerApplication(data) {
      return data.keys().hasAll(['userId', 'fullName', 'school', 'status', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.fullName is string &&
             data.school is string &&
             data.status == 'pending' &&
             data.createdAt is timestamp;
    }

    function isValidTransaction(data) {
      return (resource != null || data.keys().hasAll(['listingId', 'listingTitle', 'buyerId', 'buyerName', 'sellerId', 'sellerName', 'amount', 'status', 'paymentMethod', 'participants', 'createdAt'])) &&
             (!('buyerId' in data) || (data.buyerId == (resource == null ? request.auth.uid : existing().buyerId) || (data.buyerId == 'manual_offline' && data.sellerId == request.auth.uid))) &&
             (!('participants' in data) || (data.participants is list && data.participants.size() == 2 && data.buyerId in data.participants && data.sellerId in data.participants)) &&
             (!('status' in data) || data.status in ['pending', 'completed', 'cancelled']) &&
             (!('amount' in data) || data.amount is number && data.amount > 0) &&
             (!('createdAt' in data) || data.createdAt == (resource == null ? request.time : existing().createdAt));
    }

    function isValidOrder(data) {
      return (resource != null || data.keys().hasAll(['order_id', 'buyer_id', 'seller_id', 'product_id', 'product_name', 'product_image', 'quantity', 'unit_price', 'total_price', 'contact_number', 'meetup_location', 'order_status', 'created_at'])) &&
             (!('buyer_id' in data) || resource == null || data.buyer_id == existing().buyer_id) &&
             (!('seller_id' in data) || resource == null || data.seller_id == existing().seller_id) &&
             (resource != null || !('buyer_id' in data) || data.buyer_id == request.auth.uid) &&
             (!('order_status' in data) || data.order_status in ['Pending', 'Confirmed', 'Completed', 'Cancelled']);
    }

    // --- 3. Collection Rules ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if request.auth.uid == "mp3cXxRdbycE2ffhXwmC2kblZYF2";
      
      allow create: if isOwner(userId) && 
                      hasRequiredProfileFields(incoming()) &&
                      isValidUserProfileSchema(incoming()) && 
                      incoming().isVerified == false && // Cannot self-verify
                      incoming().role == 'buyer';      // Default role
      
      allow update: if (isOwner(userId) && 
                      isValidUserProfileSchema(incoming()) &&
                      (!('email' in incoming()) || incoming().email == existing().email) &&
                      (isDeveloper() || (
                        (!('role' in incoming()) || incoming().role == existing().role) &&
                        (!('isVerified' in incoming()) || incoming().isVerified == existing().isVerified)
                      )) &&
                      (!('createdAt' in incoming()) || incoming().createdAt == existing().createdAt)) ||
                      (request.auth.uid == "mp3cXxRdbycE2ffhXwmC2kblZYF2" && isValidUserProfileSchema(incoming()));
    }

    match /users/{userId}/favorites/{listingId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/files/{fileId} {
      allow read, write: if isOwner(userId);
      allow read: if request.auth.uid == "mp3cXxRdbycE2ffhXwmC2kblZYF2";
      allow list: if request.auth.uid == "mp3cXxRdbycE2ffhXwmC2kblZYF2";
    }

    match /files/{fileId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow read: if request.auth.uid == "mp3cXxRdbycE2ffhXwmC2kblZYF2";
      allow list: if request.auth.uid == "mp3cXxRdbycE2ffhXwmC2kblZYF2";
    }

    match /sellerApplications/{userId} {
      allow get: if isOwner(userId) || request.auth.uid == "mp3cXxRdbycE2ffhXwmC2kblZYF2";
      allow list: if request.auth.uid == "mp3cXxRdbycE2ffhXwmC2kblZYF2";
      allow create: if isOwner(userId) && isValidSellerApplication(incoming());
      allow update: if (isOwner(userId) && isValidSellerApplication(incoming())) ||
                      (request.auth.uid == "mp3cXxRdbycE2ffhXwmC2kblZYF2");
    }

    match /listings/{listingId} {
      allow read: if isSignedIn();
      allow create: if isVerifiedSeller() && 
                      incoming().sellerId == request.auth.uid;
      allow update: if (
                      // Action 1: Owner Update (can edit listing properties)
                      isOwner(existing().sellerId) && 
                      isValidListing(incoming()) &&
                      incoming().sellerId == existing().sellerId &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['title', 'price', 'description', 'category', 'images', 'status', 'tags', 'condition', 'quantity', 'location', 'contactMethod', 'updatedAt', 'views', 'inquiries'])
                    ) || (
                      // Action 2: Buyer Purchase (buyer marks item status as sold)
                      isSignedIn() && 
                      existing().status == 'active' &&
                      incoming().status == 'sold' &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
                      incoming().updatedAt == request.time
                    ) || (
                      // Action 3: Global View Count Increment (any viewer increments views)
                      isSignedIn() && 
                      incoming().diff(existing()).affectedKeys().hasOnly(['views']) &&
                      incoming().views == existing().views + 1
                    );
      allow delete: if isOwner(existing().sellerId);
    }

    match /reviews/{reviewId} {
      // Public can read approved reviews for any listing
      allow read, list: if isSignedIn() && (
        resource.data.status == 'approved' || 
        resource.data.customerId == request.auth.uid || 
        resource.data.sellerId == request.auth.uid
      );

      allow create: if isSignedIn() && isValidReview(incoming());
      
      allow update: if isSignedIn() && (
        // Seller can reply or archive
        (isOwner(existing().sellerId) && 
         incoming().diff(existing()).affectedKeys().hasOnly(['sellerReply', 'status'])) ||
        // Admin can approve/reject (not implemented here, but rules allow for future admin logic)
        (false) 
      );
    }

    match /chats/{chatId} {
      allow read: if isSignedIn() && request.auth.uid in existing().participants;
      allow create: if isEmailVerified() && isValidChat(incoming());
      allow update: if isSignedIn() && request.auth.uid in existing().participants &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'lastMessageAt', 'archivedBy']);
      allow delete: if isSignedIn() && request.auth.uid in existing().participants;
      
      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isEmailVerified() && isValidMessage(incoming()) &&
                      request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow delete: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }

    match /transactions/{transactionId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && isValidTransaction(incoming());
      allow update: if isSignedIn() && 
                    request.auth.uid in existing().participants &&
                    isValidTransaction(incoming()) && (
                      // Only seller can confirm completion
                      (request.auth.uid == existing().sellerId && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
                      // Either can cancel a pending one
                      (existing().status == 'pending' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) && incoming().status == 'cancelled')
                    );
    }

    match /orders/{orderId} {
      allow read, list: if isSignedIn() && (resource.data.buyer_id == request.auth.uid || resource.data.seller_id == request.auth.uid);
      allow create: if isSignedIn() && incoming().buyer_id == request.auth.uid && isValidOrder(incoming());
      allow update: if isSignedIn() && (resource.data.buyer_id == request.auth.uid || resource.data.seller_id == request.auth.uid) && isValidOrder(incoming()) && (
                      // Only seller can confirm or mark completed
                      (request.auth.uid == existing().seller_id && incoming().diff(existing()).affectedKeys().hasOnly(['order_status'])) ||
                      // Either buyer or seller can cancel a pending/confirmed order
                      (incoming().order_status == 'Cancelled' && incoming().diff(existing()).affectedKeys().hasOnly(['order_status']))
                    );
    }
  }
}
